<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableCell?>
<VBox alignment="CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mpaz.pokemon2.controller.PokemonController">
    <padding>
        <Insets bottom="15" left="15" right="15" top="15"/>
    </padding>

    <!--FORMULARIO PARA AGREGAR UN ELEMENTO-->
    <HBox spacing="8.0" alignment="CENTER">
            <TextField fx:id="txtId" prefWidth="60.0" promptText="ID" />
            <TextField fx:id="txtNombre" promptText="Nombre" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtTipo" promptText="Tipo" HBox.hgrow="ALWAYS"/>
            <Button
                    text="Guardar"
                    onAction="#onGuardarClick"
                    style="
                        -fx-background-color:#2eec71;
                        -fx-text-fill: white;"
            />
    </HBox>

    <!-- TABLEVIEW BASICO -->
    <TableView fx:id="tableView" prefWidth="450.0" prefHeight="300.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID"/>
            <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre (Doble click)"/>
            <TableColumn fx:id="colTipo" prefWidth="170.0" text="Tipo"/>
        </columns>
    </TableView>

    <!-- BOTON PARA ELIMINAR-->
    <Button
        text="Eliminar Seleccionado"
        onAction="#onEliminarClick"

    />




</VBox>
